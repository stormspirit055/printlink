NODE_ENV=development
PORT=4311
WEB_ORIGIN=http://localhost:5173
# Production Compose Web binding. Use 127.0.0.1:8080 behind a same-host reverse proxy.
WEB_BIND=80
# Omit to default to true in production and false otherwise. Set false only
# during temporary HTTP-over-IP acceptance testing.
# COOKIE_SECURE=false
DATABASE_URL=postgresql://printlink:printlink@localhost:5432/printlink?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters

# OTP / SMS ---------------------------------------------------------------
# console = dev gateway that echoes the code in the API response (no real SMS).
# aliyun / tencent = real channels; require the credentials below and approved
# signature/template. The API refuses `console` in production.
OTP_PROVIDER=console
OTP_RESEND_COOLDOWN_SEC=60
# Aliyun phone number verification service (dypns.console.aliyun.com).
# Select OTP_PROVIDER=aliyun-pnvs; use this product's system sign and template.
# ALIYUN_PNVS_ACCESS_KEY_ID=
# ALIYUN_PNVS_ACCESS_KEY_SECRET=
# ALIYUN_PNVS_SIGN_NAME=
# ALIYUN_PNVS_TEMPLATE_CODE=
# Comma-separated dev-phone bypass list (honoured only when NODE_ENV!=production).
# Codes for these phones are fixed at 000000 and skip Redis.
DEV_LOGIN_PHONES=13800000000,13900000001,13900000002

# Aliyun Dysms (required when OTP_PROVIDER=aliyun)
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxx

# Tencent Cloud SMS (required when OTP_PROVIDER=tencent)
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=

STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Production OSS ----------------------------------------------------------
# Set STORAGE_PROVIDER=oss in the production environment, then fill the
# following fields. Keep the Bucket private and inject credentials as Secrets.
# Aliyun OSS (required when STORAGE_PROVIDER=oss)
# Keep the bucket private. Use the public endpoint unless the API runs in the
# same Aliyun region and can reach the OSS internal endpoint.
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=printlink-models
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_INTERNAL=false
# OSS_PREFIX=models
# OSS_SIGNED_URL_EXPIRES_SEC=600
# STS direct-upload credentials (required when STORAGE_PROVIDER=oss)
# OSS_STS_ROLE_ARN=acs:ram::1234567890:role/printlink-upload
# OSS_STS_SESSION_NAME=printlink-upload
# OSS_STS_DURATION_SEC=3600
# OSS_STS_ENDPOINT=
